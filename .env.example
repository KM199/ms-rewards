# Copy to .env and fill in (never commit .env).
#
# Optional: one Telegram message after each ./run.sh or ./run-now.sh run.

# From @BotFather → /newbot
TELEGRAM_BOT_TOKEN=

# Your chat id (see README “Telegram notifications”)
TELEGRAM_CHAT_ID=

# Set to 0 to disable without deleting the file
# TELEGRAM_ENABLED=0

# --- Background daily scheduling (optional; see README Mode B) ---
# Use com.ms-rewards.supervisor.plist.example instead of the 8:00 calendar plist.
# SUPERVISOR_EARLIEST_HOUR=8
# SUPERVISOR_LATEST_HOUR=23
# SUPERVISOR_MIN_UPTIME_SEC=120
